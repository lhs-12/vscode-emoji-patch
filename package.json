{
  "name": "emoji-patch",
  "displayName": "Emoji Patch",
  "version": "0.2.0",
  "private": true,
  "description": "个人专用: 让 emoji 走 Noto Color Emoji (彩色 + 严格 2 格), 并让 markdowntable 的格式化改走 oxfmt",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "publisher": "lhs-12",
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "tsc -p . --noEmit && oxlint",
    "test": "node test/run.js",
    "package": "aube dlx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/vscode": "1.138.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "emojiPatch.enable",
        "title": "生效",
        "category": "Emoji Patch"
      },
      {
        "command": "emojiPatch.disable",
        "title": "失效",
        "category": "Emoji Patch"
      }
    ],
    "configuration": {
      "title": "Emoji Patch",
      "properties": {
        "emojiPatch.codeRoot": {
          "type": "string",
          "default": "/usr/share/code/resources/app",
          "description": "VSCode app 根目录 (含 product.json 与 out/ 的目录)"
        },
        "emojiPatch.codeFont": {
          "type": "string",
          "default": "",
          "description": "要顶替的字体族名. 留空则自动取 editor.fontFamily 的第一个族"
        },
        "emojiPatch.notoFamily": {
          "type": "string",
          "default": "Noto Color Emoji"
        },
        "emojiPatch.sizeAdjust": {
          "type": "string",
          "default": "80.3%"
        },
        "emojiPatch.oxfmtPath": {
          "type": "string",
          "default": "",
          "description": "oxfmt 可执行文件路径. 留空则自动探测"
        },
        "emojiPatch.patchMarkdownTable": {
          "type": "boolean",
          "default": true,
          "description": "把 markdowntable 的表格格式化改走 oxfmt (仅内存包装, 不改它的文件)"
        },
        "emojiPatch.patchPreview": {
          "type": "boolean",
          "default": true,
          "description": "给 Markdown Preview Enhanced 的预览注入同一份 emoji 字体块 (仅内存劫持 webview, 不改任何文件)"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.138.0"
  },
  "//@types/node": "大版本必须与 mise.toml 里的 node (lts) 一致 —— 它描述的是运行时 Node 的 API 面, 落后会误报, 超前会放行运行时没有的 API"
}
